  m_Script: {fileID: 11500000, guid: d8c8072d2125b034db50ac10816f2018, type: 3}
  m_Name: landmark_12
  m_EditorClassIdentifier: 
  text1: "Si demain tu te r\xE9veillais dans le corps de la personne que tu d\xE9testes
    le plus."
  text2: Une personne que tu connais bien.
  text3: "La personne qui t'ait fait le plus de mal, qui t'ait caus\xE9 le plus de
    tort."
  text4: "Si demain tu te r\xE9veillais dans son corps pour 24h."
  text5: "Tu chercherais \xE0 t'am\xE9liorer ou bien tu te ferais du mal ?"
  text6: 
  answer1: "S'am\xE9liorer "
  answer2: Se faire du mal
  text1_EN: If you woke up tomorrow in the body of the person you hate the most.
  text2_EN: A person you know well.
  text3_EN: The person who has hurt you the most, who has caused you the most harm.
  text4_EN: If you woke up in their body for 24 hours.
  text5_EN: Would you try to improve yourself, or would you hurt yourself?
  text6_EN: 
  answer1_EN: Improve yourself
  answer2_EN: Hurt yourself
  type: 3
  nbTexts: 4
